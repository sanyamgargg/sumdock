  "notes": [
    "County and municipal permissive taxes on registration and deputy registrar fees are not included.",
    "The tax base includes manufacturer rebates and cash down payments do not reduce it; the calculator uses the price you enter.",
    "Leased vehicles, gifts and private sales follow other rules; not modeled."
  ],
  "content": {
    "intro": "{state} charges {stateRate} state sales tax plus a county tax, so the total rate depends on where you live. You pay a title fee and a registration fee, and electric vehicles pay an extra yearly fee.",
    "howItWorks": [
      {
        "text": "The state rate is {stateRate}. Each county adds its own rate, and the tax uses the rate in the county where you live. Pick your county and the calculator fills in the combined rate from the Department of Taxation table, which is published by quarter.",
        "sources": [
          "https://tax.ohio.gov/business/sales-and-use-tax/rate-tables/by-county-q4-2026",
          "https://tax.ohio.gov/business/sales-and-use-tax/motor-vehicles"
        ]
      },
      {
        "text": "A trade-in lowers the price only when you buy a new vehicle. When you trade one used vehicle for another, the trade-in does not reduce the taxable price. This calculator does not ask whether the vehicle is new, so it shows no trade-in credit.",
        "sources": [
          "https://tax.ohio.gov/business/sales-and-use-tax/motor-vehicles"
        ]
      },
      {
        "text": "If you paid sales or use tax to another state on the same vehicle, {state} generally allows a credit. If the tax paid elsewhere is as much as the Ohio tax, nothing more is owed.",
        "sources": [
          "https://tax.ohio.gov/business/sales-and-use-tax/motor-vehicles"
        ]
      },
      {
        "text": "The title fee is charged once, and some counties add a small amount. Registration is a yearly fee. Electric vehicles pay an extra yearly fee, and hybrids and plug-in hybrids pay smaller ones.",
        "sources": [
          "https://codes.ohio.gov/ohio-revised-code/section-4505.09",
          "https://www.bmv.ohio.gov/doc-fees.aspx",
          "https://www.bmv.ohio.gov/vr-firstissuance.aspx"
        ]
      }
    ],
    "faq": [
      {
        "q": "Does a trade-in lower the sales tax in Ohio?",
        "text": "Only if you buy a new vehicle. When a used vehicle is traded for another used vehicle, the trade-in does not reduce the price that is taxed.",
        "sources": [
          "https://tax.ohio.gov/business/sales-and-use-tax/motor-vehicles"
        ]
      },
      {
        "q": "Which county rate applies to my purchase?",
        "text": "The rate of the county where you live applies, not the county of the dealer.",
        "sources": [
          "https://tax.ohio.gov/business/sales-and-use-tax/motor-vehicles"
        ]
      },
      {
        "q": "What if I bought the vehicle in another state?",
        "text": "Ohio generally gives credit for tax legally paid to another state. Bring proof of the tax paid to the clerk of courts.",
        "sources": [
          "https://tax.ohio.gov/business/sales-and-use-tax/motor-vehicles"
        ]
      },
      {
        "q": "Do hybrids pay an extra fee?",
        "text": "Yes. Hybrids and plug-in hybrids pay a yearly fee, and electric vehicles pay a larger one. This calculator adds the electric vehicle fee and not the hybrid fees.",
        "sources": [
          "https://www.bmv.ohio.gov/vr-firstissuance.aspx"
        ]
      },
      {
        "q": "Why can the title fee be higher in some counties?",
        "text": "A county can adopt a resolution that raises the title fee by a few dollars. The calculator uses the base fee.",
        "sources": [
          "https://codes.ohio.gov/ohio-revised-code/section-4505.09"
        ]
      }
    ]
  }
}
