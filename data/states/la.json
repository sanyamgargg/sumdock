  "notes": [
    "Public tag agents may charge a convenience fee on top of state fees, which is not included.",
    "Mortgage or lien recording fees apply only when the vehicle is financed and are not included.",
    "Parish and city sales tax must be entered by hand; the calculator has no parish rate list yet."
  ],
  "content": {
    "intro": "{state} charges {stateRate} state sales tax on a vehicle, plus parish and city tax based on where the buyer lives. The license plate fee depends on the vehicle's value and is paid two years at a time.",
    "howItWorks": [
      {
        "text": "The state rate is set by the Department of Revenue. Local sales tax is based on the buyer's home, not where the dealer is.",
        "sources": [
          "https://revenue.louisiana.gov/tax-education-and-faqs/faqs/sales-tax-reform/what-is-the-state-sales-tax-rate/",
          "https://dam.ldr.la.gov/publications/20164-6-20.pdf"
        ]
      },
      {
        "text": "A trade-in that is separately stated and similar to the vehicle bought comes off the sales price before tax.",
        "sources": [
          "https://dam.ldr.la.gov/lawspolicies/LAC%2061%20I%204301%204404%20and%204408%20(Current%20Regulation).pdf"
        ]
      },
      {
        "text": "The Office of Motor Vehicles charges a set percentage of the vehicle's value for the plate, with a minimum value, and sells plates two years at a time.",
        "sources": [
          "https://expresslane.la.gov/omv/vehicles/vehicle-registration-title-plate-fees/"
        ]
      }
    ],
    "faq": [
      {
        "q": "Does {state} give credit for tax paid in another state?",
        "text": "Yes, when that state gives the same credit for {state} tax. The credit compares tax rates rather than dollar amounts, so the calculator's credit is an estimate.",
        "sources": [
          "https://dam.ldr.la.gov/lawspolicies/RIB-011%20on%20Calculation%20of%20Use%20Tax%20on%20Vehicles%20Registered%20by%20New%20Residents.pdf",
          "https://dam.ldr.la.gov/publications/20164-6-20.pdf"
        ]
      }
    ]
  }
}
