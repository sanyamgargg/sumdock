  "content": {
    "intro": "{state} charges {stateRate} state sales tax on a vehicle, plus a county tax of one half of a percent in most counties and a city tax in the City of Milwaukee. Title and registration fees are paid on top.",
    "howItWorks": [
      {
        "text": "The state rate is {stateRate}. A trade-in comes off the price before the tax is figured, as long as you trade in a product and not a service.",
        "sources": [
          "https://www.revenue.wi.gov/DOR%20Publications/pb201.pdf",
          "https://wisconsindot.gov/Pages/online-srvcs/title-vehicle/faqs-purchase-price.aspx"
        ]
      },
      {
        "text": "Counties add their own tax where the vehicle will be kept, and the City of Milwaukee adds a city tax on top. Two counties have no county tax.",
        "sources": [
          "https://www.revenue.wi.gov/Pages/FAQS/pcs-taxrates.aspx",
          "https://www.revenue.wi.gov/DOR%20Publications/2113usedvehicles.pdf"
        ]
      },
      {
        "text": "Registration is paid each year. Electric vehicles pay a surcharge, and some counties and municipalities add a wheel tax that is not part of this total.",
        "sources": [
          "https://wisconsindot.gov/Pages/dmv/vehicles/title-plates/fee-chart.aspx",
          "https://wisconsindot.gov/Pages/dmv/vehicles/title-plates/dmv-fees.aspx"
        ]
      }
    ],
    "faq": [
      {
        "q": "Does a trade-in lower the sales tax in Wisconsin?",
        "text": "Yes. The tax is figured on the price of the vehicle you buy less the amount allowed for the vehicle you trade in.",
        "sources": [
          "https://www.revenue.wi.gov/DOR%20Publications/pb201.pdf"
        ]
      },
      {
        "q": "Which county's tax do I pay?",
        "text": "The tax for the county where the vehicle will be customarily kept.",
        "sources": [
          "https://www.revenue.wi.gov/DOR%20Publications/2113usedvehicles.pdf"
        ]
      },
      {
        "q": "What if I paid sales tax in another state?",
        "text": "Wisconsin gives credit for sales or use tax properly paid to another state, up to the Wisconsin tax owed.",
        "sources": [
          "https://www.revenue.wi.gov/DOR%20Publications/pb201.pdf"
        ]
      },
      {
        "q": "Why is the wheel tax not in the total?",
        "text": "Some counties and municipalities charge it, and the amount depends on where the vehicle is kept, so it is shown as not included.",
        "sources": [
          "https://wisconsindot.gov/Pages/dmv/vehicles/title-plates/dmv-fees.aspx"
        ]
      }
    ]
  }
}
