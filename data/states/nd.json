  "content": {
    "intro": "{state} charges a {stateRate} excise tax on the price of a vehicle instead of a sales tax. Registration is paid every year and depends on weight and on the year the vehicle was first registered.",
    "howItWorks": [
      {
        "text": "The excise tax is {stateRate} of the price less any trade-in, paid when you apply for a title.",
        "sources": [
          "https://www.tax.nd.gov/node/256"
        ]
      },
      {
        "text": "North Dakota gives credit for excise tax paid in another state only if that state gives North Dakota a reciprocal credit.",
        "sources": [
          "https://www.tax.nd.gov/node/256"
        ]
      },
      {
        "text": "The registration fee depends on the vehicle's weight and the year it was first registered, and newer vehicles pay more.",
        "sources": [
          "https://www.dot.nd.gov/sites/www/files/documents/Motor%20Vehicle%20Services/mvd-2-passenger-fee-2026.pdf"
        ]
      }
    ],
    "faq": [
      {
        "q": "Does a trade-in lower the excise tax in North Dakota?",
        "text": "Yes, the tax is figured on the sales price less any trade-in amount.",
        "sources": [
          "https://www.tax.nd.gov/node/256"
        ]
      },
      {
        "q": "Is registration based on the model year?",
        "text": "No. The schedule uses the year the vehicle was first registered.",
        "sources": [
          "https://www.dot.nd.gov/sites/www/files/documents/Motor%20Vehicle%20Services/mvd-2-passenger-fee-2026.pdf"
        ]
      }
    ]
  }
