  "notes": [
    "The value part of registration for a used vehicle is not included because it uses the DOT's value for the vehicle.",
    "Lien notation and county treasurer fees are not included.",
    "Any electric or hybrid vehicle registration fee is not included."
  ],
  "content": {
    "intro": "{state} charges a fee for new registration instead of sales tax: ten dollars plus {stateRate} of the price less a trade-in. Yearly registration combines a share of the vehicle's value and a fee by weight.",
    "howItWorks": [
      {
        "text": "The fee for new registration is ten dollars plus five percent of the purchase price. A trade-in comes off the price when the same person is on both titles.",
        "sources": [
          "https://www.legis.iowa.gov/docs/code/321.105A.pdf"
        ]
      },
      {
        "text": "Tax paid to another state is credited against the fee, and only the difference is collected.",
        "sources": [
          "https://www.legis.iowa.gov/docs/code/321.105A.pdf"
        ]
      },
      {
        "text": "Yearly registration is one percent of the value the DOT sets for the vehicle plus forty cents for each hundred pounds.",
        "sources": [
          "https://www.legis.iowa.gov/docs/code/321.109.pdf"
        ]
      },
      {
        "text": "The title fee is set in the Iowa Code and was last raised by a law that took effect at the start of the year after it passed.",
        "sources": [
          "https://www.legis.iowa.gov/docs/publications/iactc/90.2/CH1145.pdf",
          "https://www.legis.iowa.gov/docs/code/321.20.pdf"
        ]
      }
    ],
    "faq": [
      {
        "q": "Does {state} charge sales tax on a vehicle?",
        "text": "No. It charges a fee for new registration instead, at the same five percent plus a fixed ten dollars.",
        "sources": [
          "https://www.legis.iowa.gov/docs/code/321.105A.pdf"
        ]
      },
      {
        "q": "Does a trade-in lower the fee for new registration?",
        "text": "Yes, when the same person is listed on the titles of both vehicles. Some relatives and co-signers also qualify.",
        "sources": [
          "https://www.legis.iowa.gov/docs/code/321.105A.pdf"
        ]
      }
    ]
  }
}
